<?php
$vetor = [5, 3, 8, 4, 2];
$n = count($vetor);
for ($i=0;$i < $n; $i++){
    for ($i = 0; $i < $n -1; $i++){
        if ($vetor[$i] > $vetor [$i+1]){
            $temp = $vetor[$i];
            $vetor [$i] = $vetor [$i+1];
            $vetor [$i+1] = $temp;
        }
    }
}
print_r($vetor);
?>